{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "cloud-mail",
  "account_id": "YOUR_CLOUDFLARE_ACCOUNT_ID",
  "main": "src/index.js",
  "compatibility_date": "2026-11-07",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "workers_dev": true,
  "preview_urls": false,
  "d1_databases": [
    {
      "binding": "db",
      "database_name": "cloud-mail-db",
      "database_id": "YOUR_D1_DATABASE_ID"
    }
  ],
  "kv_namespaces": [
    {
      "binding": "kv",
      "id": "YOUR_KV_NAMESPACE_ID"
    }
  ],
  "assets": {
    "binding": "assets",
    "directory": "./dist",
    "not_found_handling": "single-page-application",
    "run_worker_first": [
      "/api/*",
      "/oss/*",
      "/static/*",
      "/attachments/*"
    ]
  },
  "triggers": {
    "crons": [
      "0 0 * * *"
    ]
  },
  "observability": {
    "enabled": false
  },
  "vars": {
    "domain": [
      "example.com"
    ],
    "admin": "admin@example.com",
    "orm_log": false,
    "analysis_cache": false,
    "personal_catch_all": true
  },
  "routes": [
    {
      "pattern": "mail.example.com",
      "custom_domain": true
    }
  ]
}
